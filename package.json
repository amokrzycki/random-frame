{
  "name": "random-frame",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "node build.mjs --watch",
    "build": "npm run typecheck && node build.mjs",
    "build:test": "esbuild src/client/*.ts --platform=browser --format=esm --sourcemap --outdir=dist/test-client",
    "test": "npm run build && npm run build:test && node --test",
    "lint": "biome check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tauri-apps/cli": "2.11.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  }
}
