{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Random Frame",
  "version": "../package.json",
  "identifier": "dev.randomframe.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Random Frame",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self' blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Adrian Mokrzycki",
    "category": "Photography",
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "appimage": {
        "files": {
          "usr/share/applications/Random Frame.desktop": "../dist/random-frame.desktop",
          "/usr/share/metainfo/Random Frame.desktop.metainfo.xml": "appimage/metainfo.xml"
        }
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1NkRBMTdERUFEODRCM0IKUldRN1M5anFmYUZ0UmJOdEtoUEQzU3AybTBZa2R5ZEZRYjJFRXl3RW9jUlFvaW1TWDVuYVNIQUcK",
      "endpoints": ["https://github.com/amokrzycki/random-frame/releases/latest/download/latest.json"]
    }
  }
}
