{
  "description": "Repository quality checks after edits and before Codex finishes a task.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/quality.py\" edit",
            "timeout": 300,
            "statusMessage": "Formatting and checking edited files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/quality.py\" final",
            "timeout": 1800,
            "statusMessage": "Running the full repository quality gate"
          }
        ]
      }
    ]
  }
}
